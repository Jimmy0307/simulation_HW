# Private browser evidence and raw Marketplace material
evidence/private/
marketplace-assets/
_marketplace_assets/
*_files/
**/*_files/

# Captures and runtime-only session material
*.har
*.HAR
*.devtools
*.session
*cookies*
*cookie*
*token*

# Python build/test artifacts and runtime-only configuration
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.coverage
.env
.env.*
!.env.example

# Local operator tooling (CDP network guard, login poller); kept out of the public repo
tools/

# Generated simulator saves (regenerable; may contain coincidental state counters)
examples/**/*-save.json
*.mpsim-save.json
# Local agent configuration (per-quarter command with operational rules)
.claude/

# Generated scenario/sweep reports (regenerable; reports built from real data stay in evidence/private/)
outputs/

# Any directory named "private" anywhere (CLI/API treat such directories as private output locations)
**/private/
# Fitted demand models and demand panels are game data
**/fitted_demand.json
**/demand_panel/
# Frontend build output and dependencies (the build is published by CI from committed sources only)
frontend/node_modules/
frontend/dist/
# git-filter-repo working files
.git-rewrite/
