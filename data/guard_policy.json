{
 "schema": "marketplace-sysid/guard-policy@1",
 "description": "Tiered allow/block policy for the local operator-experiment network guard (backend-json.php RPCs). Method names and tiers only.",
 "evaluation_order": ["baseline", "strict", "selftest", "experiment", "unknown"],
 "baseline": {
  "decision": "allow",
  "reason": "Calls the page makes on every normal login or refresh; not experiment effects. Blocking them disables the page.",
  "pairs": [
   "TokenProvider.getHeaderToken", "TokenProvider.deleteRefreshToken",
   "StudentInit.runInit", "StudentInit.runFinish",
   "ServiceStatus.gs",
   "Settings.saveSettings", "Settings.saveQuarterScreenSettings",
   "Email.getNewEmailsCount",
   "GameInfo.studentsOnline"
  ]
 },
 "strict": {
  "decision": "block",
  "anomaly": true,
  "methods_any_service": ["save", "createChatSession", "createResponse"],
  "services_all_methods": ["WrapUp", "Chat", "Email"]
 },
 "selftest": {
  "decision": "block",
  "applies_when_mode": "selftest-block-view:<Service>",
  "target": "<Service>.view only"
 },
 "experiment": {
  "decision": "allow",
  "any_service_methods": ["view"],
  "active_experiment": "NONE",
  "service_methods": {},
  "history": {
   "EXP-01": {"CD": ["view", "modify", "calculate", "cancel", "validateLock", "prolongLock"]},
   "EXP-02": {"FixedCapacity": ["view", "modify", "calculate", "cancel", "validateLock", "prolongLock"]},
   "EXP-03": {"OpenSalesOffice": ["view", "modify", "calculate", "cancel", "validateLock", "prolongLock"]},
   "EXP-04": {"OpenWebcenter": ["view", "modify", "calculate", "cancel", "validateLock", "prolongLock"]}
  }
 },
 "unknown": {"decision": "block", "log": true, "note": "Unknown methods seen during page load are reported to the operator, never auto-added."},
 "block_mechanism": {
  "default": "Fetch.fulfillRequest with {\"error\":-10} (client's silent abort code; avoids native alert dialogs)",
  "alternative_allowed_for": ["ServiceStatus.gs (Fetch.failRequest BlockedByClient)"]
 },
 "logging": "service, method, tier, decision, time only; never headers, tokens or bodies"
}
