{
  "name": "mpsim-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web UI for the local mpsim planning simulator (static synthetic demo or live local API).",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode live",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
